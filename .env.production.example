# =============================================================================
# Production environment template
# =============================================================================
# Copy this file to .env on the production server and fill in the real values.
# Never commit the production .env to source control.
#
#   cp .env.production.example .env
#   php artisan key:generate --force
#
# After editing .env run:
#   php artisan optimize
# =============================================================================

APP_NAME="BMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# Force generated URLs to https:// (enable when TLS is configured).
APP_FORCE_HTTPS=true

# Comma-separated proxy IPs/CIDRs, or "*" when the app runs behind a trusted
# load balancer/Cloudflare and cannot be reached directly. Leave blank otherwise.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Keep stack traces out of responses; write warnings and errors to disk.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bms
DB_USERNAME=bms_app
DB_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Session / cache / queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (needed for registration/replacement sign-in code emails)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# Owner address that receives registration codes and notices.
BMS_REGISTRATION_NOTIFICATION_EMAIL=owner@your-domain.example

# -----------------------------------------------------------------------------
# Object storage (only needed if you move uploads off the local disk)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
