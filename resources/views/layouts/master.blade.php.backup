        ];
    @endphp

    <div x-data="{
        userMenuOpen: false,
        mobileSearchOpen: false,
        showProfileModal: false,
        activeNav: '{{ $activeNav }}',
        setActive(key) { this.activeNav = key },

        // ===== Global search =====
        searchQuery: '',
        searchOpen: false,
        searchResults: [],
        searchJumps: [],
        searchIndex: 0,
        runSearch() {
            const q = (this.searchQuery || '').trim();
            this.searchIndex = 0;
            if (!q) {
                this.searchResults = [];
                this.searchJumps = (window.BmsSearch && window.BmsSearch.jumps) ? window.BmsSearch.jumps() : [];
                return;
            }
            this.searchJumps = [];
            this.searchResults = (window.BmsSearch && window.BmsSearch.query) ? window.BmsSearch.query(q) : [];
        },
        moveSelection(delta) {
            const total = this.searchResults.length;
            if (!total) { return; }
            this.searchIndex = (this.searchIndex + delta + total) % total;
        },
        openResult(result) {
            if (!result) { return; }
            window.location.href = result.url;
        },
        openFirstResult() {
            if (this.searchResults.length) { this.openResult(this.searchResults[0]); }
        },
        clearSearch() {
            this.searchQuery = '';
            this.searchResults = [];
            this.searchOpen = false;
            this.mobileSearchOpen = false;
        },

        // ===== Administrator profile =====
        csrf: document.querySelector('meta[name=\"csrf-token\"]') ? document.querySelector('meta[name=\"csrf-token\"]').content : '',
        endpoints: @json($endpoints),
        profile: {
            name: @json($adminName),
            email: @json($adminEmail),
            phone: @json($adminPhone),
            businessName: @json($adminBusiness),
            initials: @json($adminInitials),
            role: @json($adminRole),
            joinDate: @json($adminJoined),
            pin: @json($adminPin),
        },
        editProfile: {
            name: @json($adminName),
            email: @json($adminEmail),
            phone: @json($adminPhone),
            businessName: @json($adminBusiness),
            password: '',
            passwordConfirmation: '',
        },
        savingProfile: false,
        regeneratingPin: false,
        profileError: '',
        profileErrors: {},
        profileSaved: false,
        openProfile() {
            this.editProfile = {
                name: this.profile.name,
                email: this.profile.email,
                phone: this.profile.phone,
                businessName: this.profile.businessName,
                password: '',
                passwordConfirmation: '',
            };
            this.profileError = '';
            this.profileErrors = {};
            this.profileSaved = false;
            this.showProfileModal = true;
            this.userMenuOpen = false;
        },
        async saveProfile() {
            this.profileError = '';
            this.profileErrors = {};
            this.profileSaved = false;

            if (this.editProfile.password && this.editProfile.password !== this.editProfile.passwordConfirmation) {
                this.profileError = 'The two passwords do not match.';
                return;
            }

            this.savingProfile = true;

            const payload = {
                name: this.editProfile.name,
                email: this.editProfile.email,
                phone: this.editProfile.phone,
                business_name: this.editProfile.businessName,
            };

            if (this.editProfile.password) {
                payload.password = this.editProfile.password;
                payload.password_confirmation = this.editProfile.passwordConfirmation;
            }

            try {
                const res = await fetch(this.endpoints.profile, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': this.csrf,
                    },
                    body: JSON.stringify(payload),
                });

                const data = await res.json();

                if (!res.ok) {
                    this.profileErrors = data.errors || {};
                    this.profileError = data.message || 'Your profile could not be saved.';
                    return;
                }

                this.profile = Object.assign({}, this.profile, data.user || {});
                this.editProfile.password = '';
                this.editProfile.passwordConfirmation = '';
                this.profileSaved = true;
                this.profileError = '';
            } catch (e) {
                this.profileError = 'Network problem — your profile could not be saved.';
            } finally {
                this.savingProfile = false;
            }
        },
        async regeneratePin() {
            this.regeneratingPin = true;
            this.profileError = '';
            try {
                const res = await fetch(this.endpoints.pin, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': this.csrf,
                    },
                });
                const data = await res.json();
                if (!res.ok || !data.ok) {
                    this.profileError = data.message || 'The sign-in code could not be changed.';
                    return;
                }
                this.profile.pin = data.pin;
                this.profileSaved = true;
            } catch (e) {
                this.profileError = 'Network problem — the sign-in code could not be changed.';
            } finally {
                this.regeneratingPin = false;
            }
        },
    }"
