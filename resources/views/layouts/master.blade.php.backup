<!DOCTYPE html>
<html lang="en" class="h-full">
@php
    $activeNav = $activeNav ?? 'dashboard';

    $barSettings = \App\Settings\BarSettings::all();
    $currency = \App\Settings\BarSettings::currency();
    $currencySymbol = $currency['symbol'];
    $currencyCode = $currency['code'];
    $currencyDecimals = $currency['decimals'];
    $barName = $barSettings['name'];
    $barLogo = \App\Settings\BarSettings::logoUrl();

    // The signed in administrator — everything in the header and the profile
    // modal is driven by this record.
    $authUser = auth()->user();
    $adminName = $authUser?->name ?: 'Administrator';
    $adminEmail = $authUser?->email ?: '';
    $adminPhone = $authUser?->phone ?: '';
    $adminBusiness = $authUser?->business_name ?: $barName;
    $adminInitials = $authUser?->initials() ?: 'AD';
    $adminRole = $authUser?->isAdministrator() ? 'Administrator' : ucfirst((string) $authUser?->role);
    $adminJoined = $authUser?->created_at ? $authUser->created_at->format('M d, Y') : '';
    $adminPin = $authUser?->pin ?: '—';

    $endpoints = [
        'profile' => route('profile.update'),
        'pin' => route('profile.pin'),
    ];
@endphp
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>@yield('title', 'Dashboard') — BMS</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    <script>
        // Global money helper — the active currency comes from Settings > Receipt.
        window.BmsMoney = {
            symbol: @json($currencySymbol),
            code: @json($currencyCode),
            decimals: {{ (int) $currencyDecimals }},
            bar: {
                name: @json($barName),
                logo: @json($barLogo),
                address: @json($barSettings['address']),
                phone: @json($barSettings['phone']),
                receipt_header: @json($barSettings['receipt_header']),
                receipt_footer: @json($barSettings['receipt_footer']),
            },
            // Format an amount with the active currency symbol.
            fmt: function (v) {
                var n = Number(v || 0);
                var fixed = n.toFixed(this.decimals);
                var parts = fixed.split('.');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                return this.symbol + ' ' + parts.join('.');
            },
        };
    </script>

    {{-- Shared datasets, the global search index and the staff helpers. --}}
    @include('partials.app-data')

    @stack('head')
</head>
<body class="h-full bg-gray-50 font-sans antialiased">
